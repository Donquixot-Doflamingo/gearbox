{
  "name": "gearbox-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gearbox admin UI (SvelteKit SPA)",
  "license": "MIT",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "PUBLIC_GEARBOX_MOCK=1 vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ts": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "python3 scripts/gen-api.py"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.36.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
