{
  "//": "Type-checks the plain .ts sources with `tsc -p tsconfig.check.json` without SvelteKit or node_modules (used where npm is unavailable). svelte-check covers .svelte files.",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "allowJs": false,
    "types": []
  },
  "include": ["typecheck/*.d.ts", "src/**/*.ts", "vite.config.ts"],
  "exclude": ["src/**/*.svelte"]
}
