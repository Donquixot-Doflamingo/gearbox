# Copy to .env (or export) to configure the UI.
# Base URL of the control-plane API. Relative URLs keep cookies same-origin.
PUBLIC_GEARBOX_API=/api/v1
# 1 = use the in-browser mock API with sample data (no backend needed).
PUBLIC_GEARBOX_MOCK=
# Dev server only: proxy /api to a running control plane.
# GEARBOX_PROXY=http://localhost:8080
