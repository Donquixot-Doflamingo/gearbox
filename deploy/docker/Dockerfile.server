# syntax=docker/dockerfile:1.7
# gearbox-server (+ gearboxctl) with the built admin UI in /ui.
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.server -t gearbox-server:dev .
# In a network-restricted sandbox add: --build-arg GEARBOX_RESTRICTED=1
ARG GO_VERSION=1.24
ARG NODE_VERSION=22

# ---- UI (SvelteKit static build → ui/build)
FROM node:${NODE_VERSION}-bookworm-slim AS ui
WORKDIR /src/ui
COPY ui/ ./
RUN set -e; \
    if [ -f package.json ]; then \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi; \
      npm run build; \
    else \
      echo "ui/package.json not found; shipping a placeholder page"; \
      mkdir -p build && echo '<!doctype html><title>Gearbox</title><p>UI not built.</p>' > build/index.html; \
    fi

# ---- Go binaries
FROM golang:${GO_VERSION}-bookworm AS build
ARG VERSION=dev
ARG GEARBOX_RESTRICTED=0
ARG TARGETOS=linux
ARG TARGETARCH=amd64
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    set -e; \
    if [ "$GEARBOX_RESTRICTED" = "1" ]; then . scripts/dev/restricted-env.sh; fi; \
    export CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH; \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/gearbox-server ./controlplane/cmd/gearbox-server; \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/gearboxctl ./controlplane/cmd/gearboxctl; \
    mkdir -p /out/data /out/keys

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gearbox-server /gearbox-server
COPY --from=build /out/gearboxctl /gearboxctl
COPY --from=ui /src/ui/build /ui
COPY examples/definitions /examples/definitions
COPY --from=build --chown=65532:65532 /out/data /data
# Mount point for dev keys (gearboxctl keys generate --out /keys); named volumes inherit the owner.
COPY --from=build --chown=65532:65532 /out/keys /keys
ENV GEARBOX_UI_DIR=/ui \
    GEARBOX_HTTP_ADDR=:8080 \
    GEARBOX_METRICS_ADDR=:9464 \
    GEARBOX_STORE=memory \
    GEARBOX_OBJECT_STORE=file:///data/objects \
    GEARBOX_SEED_DIR=/examples/definitions
USER 65532:65532
EXPOSE 8080 9464
ENTRYPOINT ["/gearbox-server"]
